# Use /api when the frontend is served behind the same reverse proxy as the API.
VITE_API_BASE_URL=/api

# Used only by the Vite development proxy.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Landing page media. These may be hosted by your CDN or object storage.
VITE_LANDING_LOGO_URL=
VITE_LANDING_HERO_URL=
VITE_LANDING_GEAR_URL=
VITE_LANDING_OXYGEN_URL=
