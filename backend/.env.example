# Database Connection (MySQL / TiDB Cloud Serverless)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=4000
DB_NAME=giripremi
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>

# JWT Authentication
SECRET_KEY=generate_a_random_32_character_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
